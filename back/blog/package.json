  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "allowScripts": {}
}
