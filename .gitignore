# Build outputs and dependency caches
**/target/
**/node_modules/
**/dist/
**/dist.next/
**/dist.previous/
**/.astro/
**/.vite/

# Runtime state is created by union on Linux and never belongs in source control
**/data/*
!**/data/
!**/data/.gitkeep

# Local environment files (only the documented template is versioned)
.env*
!.env.production.example

# Editor and coding-agent state
.idea/
.vscode/
.claude/
.codex/
.agents/

# Local binary assets
WOFF2/
