# Production baseline. Replace the three hostnames and paths for your server.
# `tls internal` is suitable for a private LAN after installing Caddy's root CA
# on every client. For public DNS names, remove it and let Caddy use ACME.

(common_security) {
    encode zstd gzip
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}

home.lan {
    tls internal
    import common_security
    header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'none'"

    root * /opt/union/blog/source/dist
    @html path / /*.html /*/
    header @html Cache-Control "no-cache"
    @fingerprinted path /_astro/*
    header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
    try_files {path} {path}/
    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }

    log {
        output file /var/log/caddy/blog.json {
            roll_size 20MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}

admin.home.lan {
    tls internal
    import common_security
    header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    header Cache-Control "no-store"
    @admin_assets path /assets/*
    header @admin_assets Cache-Control "public, max-age=31536000, immutable"

    handle /api/* {
        reverse_proxy 127.0.0.1:8080 {
            health_uri /api/ready
            health_interval 30s
            transport http {
                dial_timeout 3s
                response_header_timeout 30s
            }
        }
    }

    handle {
        root * /opt/union/back/source/dist
        try_files {path} /index.html
        file_server
    }

    log {
        output file /var/log/caddy/back.json {
            roll_size 20MiB
            roll_keep 30
            roll_keep_for 2160h
        }
        format json
    }
}

files.home.lan {
    tls internal
    import common_security
    header Content-Security-Policy "default-src 'self'; object-src 'none'; frame-ancestors 'none'"
    reverse_proxy 127.0.0.1:5000

    log {
        output file /var/log/caddy/ram.json {
            roll_size 50MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}
