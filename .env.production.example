# Install as /etc/union/union.env with mode 0600.
UNION_ENV=production
UNION_DATABASE_URL=postgresql://union:REPLACE_ME@127.0.0.1:5432/union?sslmode=disable
# Generate with: openssl rand -base64 32
UNION_SECRET_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Required only until the first administrator is created; then remove this line.
UNION_BOOTSTRAP_PASSWORD=REPLACE_WITH_AT_LEAST_12_RANDOM_CHARACTERS
UNION_RAM_PUBLIC_URL=https://files.home.lan
UNION_RETENTION_DAYS=90
PUBLIC_SITE_URL=https://home.lan
RUST_LOG=union=info,tower_http=info
